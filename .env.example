# Local demo is self-contained. No API key or SpacetimeDB needed.
LATTICE_PORT=4318
LATTICE_DATA_DIR=.data
LATTICE_AGENT_PROVIDER=fixture

# Optional server-side extraction API. Never put an API key in VITE_* variables.
# LATTICE_AGENT_PROVIDER=model
# LATTICE_MODEL_BASE_URL=https://your-provider.example/v1
# LATTICE_MODEL=your-model-name
# LATTICE_MODEL_API_KEY=

# Optional fixed credentials for independently launched agent CLI processes.
# Configure the same credential in the server and that agent's environment.
# LATTICE_AGENT_A_TOKEN=
# LATTICE_AGENT_B_TOKEN=
# LATTICE_AGENT_C_TOKEN=
# LATTICE_AGENT_D_TOKEN=
# LATTICE_SERVER_URL=http://127.0.0.1:4318

# Frontend live mode requires registering the generated-bindings adapter first.
VITE_DATA_MODE=local
# VITE_SPACETIMEDB_URI=ws://127.0.0.1:3000
# VITE_SPACETIMEDB_DATABASE=lattice-demo
