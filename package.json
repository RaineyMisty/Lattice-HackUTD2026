{
  "name": "lattice-incident-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts apps/web",
    "dev:server": "tsx apps/server/src/index.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts apps/web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:db": "node scripts/test.mjs --database-only",
    "agent": "tsx packages/agents/src/cli.ts",
    "start": "tsx apps/server/src/index.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
