{
  "name": "lattice-incident-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts frontend",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:db": "node scripts/test.mjs --database-only",
    "test:live": "node --import tsx --test db/test/live.test.ts",
    "agent": "tsx agents/src/cli.ts",
    "setup:local": "tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
